{
  "name": "kbc-turnier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:exec --project=kbc-turnier \"vite --host\" --import=./backup/emulator_data --export-on-exit=./backup/emulator_data",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name kbc-turnier",
    "emulators": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:start --project=kbc-turnier --import=./backup/emulator_data --export-on-exit=./backup/emulator_data",
    "emulators:clean": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:start --project=kbc-turnier",
    "data:export": "tsx scripts/exportProdData.ts",
    "data:import": "tsx scripts/importEmulatorData.ts",
    "backup:prod": "tsx scripts/backupProdData.ts"
  },
  "dependencies": {
    "@fontsource-variable/chivo-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "firebase-tools": "^15.34.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.152.0"
  }
}
