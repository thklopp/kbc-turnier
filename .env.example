# Firebase Client SDK Konfiguration
# Zu finden in der Firebase Console -> Projekteinstellungen -> Allgemein -> Meine Apps
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Local Emulator Suite (optional)
# Auf "true" setzen, um die lokale Web-App mit dem Emulator statt mit Production zu verbinden
VITE_USE_FIREBASE_EMULATOR=false
# Optional: Host fuer den Emulator (Standard: 127.0.0.1)
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Admin Credentials (optional fuer Daten-Export/-Import/Seed-Skripte)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Umami Web Analytics (optional, leer lassen zur Deaktivierung)
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_HOST_URL=https://cloud.umami.is
